# Dependencies
node_modules/

# Environment
.env

# Python
__pycache__/
*.pyc
venv/
.venv/
.pytest_cache/

# Build output
dist/
build/

# Logs
*.log

# OS
.DS_Store

# Claude Code local state
.claude/

# Local scratch space and run logs
.scratch/
logs/

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Trace memory database
traces.db

# Demo recordings. Four clips, about 10 MB of video, regenerated in one
# command from the same runs they show (demo/README.md) — so they are a
# fallback for a room with no internet, not repository history.
demo/*.webm
demo/_raw/

# Frontend build output
frontend/dist/
frontend/dist-electron/
*.tsbuildinfo

# Channel B's recordings: one row per telemetry sample, paired with the page
# features of the step it belongs to. It carries the goals a person typed, so
# it stays on the machine that recorded it — the corpus beside it
# (data/corpus.json) is public pages and is committed.
data/steps.jsonl

# The rating tool (tools/rating/). The pictures are other people's sites,
# regenerated by `python -m tools.rating.capture`; their hashes and states are
# in data/rating/pages.json, which is committed. The ratings are people's
# answers and stay on the machine that recorded them, like data/steps.jsonl.
data/rating/pages/
data/ratings.jsonl
# The forms' downloads, wherever they were saved: people's answers, with the
# time each was sent (tools/rating/form/README.md).
SIMBA rating form*.csv
responses-*.csv

# Saved sign-in details (backend/orchestrator/vault.py). Encrypted with this
# Windows account's own key, and still never committed.
data/vault.json

# The worked examples shown before the first rating picture (tools/rating/examples.py):
# other people's sites again, regenerated by that command; their hashes are in
# data/rating/examples.json, which is committed.
data/rating/examples/
