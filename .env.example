# Copy to .env and fill in. .env is never committed (see CLAUDE.md).

# Which planner to use: anthropic | openai
SIMBA_LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Any OpenAI-compatible endpoint. Leave OPENAI_BASE_URL unset for OpenAI itself.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Pin an exact model string, never an alias like *-latest: aliases move
# under you and make two benchmark runs incomparable. Record whatever you
# pin in EVALUATION.md.
OPENAI_MODEL=gemini-3.1-flash-lite

# Thinking effort for the Anthropic planner: low | medium | high | xhigh | max
SIMBA_LLM_EFFORT=low

# Set to 1 to use the hardcoded plan instead of the LLM (deterministic fallback)
SIMBA_USE_HARDCODED_PLAN=0

# --- AI on any website (2026-11-13) -----------------------------------------
# Gemini through its OpenAI-compatible endpoint is the main provider:
#   SIMBA_LLM_PROVIDER=openai
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_API_KEY=<your Gemini key>
#   OPENAI_MODEL=gemini-3.1-flash-lite
# Its free tier may use what is sent to improve Google's products: use a paid
# key for anything run with a real person or real account (DECISIONS.md).
#
# Groq is the automatic fallback when Gemini is rate-limited or unreachable.
# Leave GROQ_API_KEY empty to run Gemini alone.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
#
# OpenRouter is the third (2026-11-13), after Groq, on one of its free models.
# Leave OPENROUTER_API_KEY empty to stop at Groq. Free models come and go:
# OPENROUTER_MODEL picks another (any id ending in ":free"). Free models may
# keep what is sent to them, like Gemini's free tier: no real person's details.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# Paid, and what SIMBA's own run uses since 2026-11-16: Gemini 2.5 Flash through OpenRouter.
# Measured against Flash-Lite on Readings (EVALUATION.md, 2026-11-16): 27 s and 2 calls
# against 35 s and 3. Flash-Lite is `google/gemini-2.5-flash-lite`, a third of the price.
# OPENROUTER_MODEL=google/gemini-2.5-flash
# Set to 0 to keep the first provider alone even with fallback keys.
SIMBA_LLM_FALLBACK=1
