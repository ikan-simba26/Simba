# Copy to .env and fill in. .env is never committed (see CLAUDE.md).

# Which planner to use: anthropic | openai
SIMBA_LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Any OpenAI-compatible endpoint. Leave OPENAI_BASE_URL unset for OpenAI itself.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Thinking effort for the Anthropic planner: low | medium | high | xhigh | max
SIMBA_LLM_EFFORT=low

# Set to 1 to use the hardcoded plan instead of the LLM (deterministic fallback)
SIMBA_USE_HARDCODED_PLAN=0
